# ARUNA Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── ISRO PRADAN data portal credentials ──────────────────────────────────────
PRADAN_USERNAME=
PRADAN_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aruna
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=aruna
DATABASE_URL=postgresql://aruna:change_me_in_production@localhost:5432/aruna

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Ollama (LLM) ──────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Python pipeline ───────────────────────────────────────────────────────────
ARUNA_CONFIG=config/config.yaml
ARUNA_FORCE_NOAA_FALLBACK=0        # set to 1 to bypass PRADAN

# ── Node API gateway ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
PYTHON_API_URL=http://localhost:8000
PORT=3001

# ── React frontend (build-time — prefix with VITE_) ──────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
