
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="400" viewBox="0 0 1200 400" fill="none">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1200" y2="400">
      <stop stop-color="#080D19"/>
      <stop offset="1" stop-color="#111D31"/>
    </linearGradient>
    <radialGradient id="sun">
      <stop stop-color="#FFF4C2"/>
      <stop offset=".35" stop-color="#FFB84D"/>
      <stop offset=".72" stop-color="#FF692F"/>
      <stop offset="1" stop-color="#E53B20" stop-opacity=".1"/>
    </radialGradient>
    <radialGradient id="glow">
      <stop stop-color="#FF873E" stop-opacity=".35"/>
      <stop offset="1" stop-color="#FF873E" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="line">
      <stop stop-color="#FF9A50" stop-opacity="0"/>
      <stop offset=".5" stop-color="#FF9A50"/>
      <stop offset="1" stop-color="#FF9A50" stop-opacity="0"/>
    </linearGradient>
    <filter id="blur">
      <feGaussianBlur stdDeviation="16"/>
    </filter>
    <filter id="soft">
      <feGaussianBlur stdDeviation="5"/>
    </filter>
    <clipPath id="clip">
      <rect width="1200" height="400" rx="18"/>
    </clipPath>
  </defs>

  <g clip-path="url(#clip)">
    <rect width="1200" height="400" fill="url(#bg)"/>

    <!-- Background stars -->
    <g fill="#DCEBFF">
      <circle cx="80" cy="65" r="1.5"/>
      <circle cx="190" cy="320" r="1"/>
      <circle cx="370" cy="55" r="1"/>
      <circle cx="480" cy="300" r="1.5"/>
      <circle cx="760" cy="65" r="1"/>
      <circle cx="1080" cy="70" r="1.5"/>
      <circle cx="1120" cy="310" r="1"/>
      <circle cx="680" cy="350" r="1"/>
      <circle cx="900" cy="330" r="1"/>
      <circle cx="300" cy="180" r="1"/>
      <circle cx="1030" cy="180" r="1"/>
    </g>

    <!-- Solar glow -->
    <circle cx="910" cy="195" r="190" fill="url(#glow)" filter="url(#blur)">
      <animate attributeName="opacity" values=".65;1;.65" dur="5s" repeatCount="indefinite"/>
    </circle>

    <!-- Solar corona -->
    <circle cx="910" cy="195" r="112" stroke="#FF9B52" stroke-width="2" opacity=".35">
      <animate attributeName="r" values="108;116;108" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values=".2;.55;.2" dur="5s" repeatCount="indefinite"/>
    </circle>

    <circle cx="910" cy="195" r="96" stroke="#FFC27A" stroke-width="1" opacity=".4" stroke-dasharray="3 9">
      <animateTransform attributeName="transform" type="rotate" from="0 910 195" to="360 910 195" dur="50s" repeatCount="indefinite"/>
    </circle>

    <!-- Sun -->
    <circle cx="910" cy="195" r="77" fill="url(#sun)"/>
    <circle cx="910" cy="195" r="77" fill="none" stroke="#FFB45C" stroke-width="3" opacity=".7">
      <animate attributeName="r" values="76;80;76" dur="4s" repeatCount="indefinite"/>
    </circle>

    <!-- Solar flare -->
    <path d="M850 130 Q800 65 850 38 Q865 90 888 113" stroke="#FFB15C" stroke-width="5" fill="none" opacity=".8" filter="url(#soft)">
      <animate attributeName="opacity" values=".2;.9;.2" dur="3s" repeatCount="indefinite"/>
    </path>

    <!-- Orbital paths -->
    <ellipse cx="910" cy="195" rx="170" ry="78" transform="rotate(-28 910 195)" stroke="#6CA6D9" stroke-opacity=".4" stroke-dasharray="5 8"/>
    <ellipse cx="910" cy="195" rx="205" ry="125" transform="rotate(24 910 195)" stroke="#6CA6D9" stroke-opacity=".18" stroke-dasharray="2 9"/>

    <!-- Orbiting satellite -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 910 195" to="360 910 195" dur="18s" repeatCount="indefinite"/>
      <g transform="translate(1080 115)">
        <circle r="15" fill="#6BB9FF" opacity=".15">
          <animate attributeName="r" values="12;19;12" dur="2s" repeatCount="indefinite"/>
        </circle>
        <rect x="-7" y="-6" width="14" height="12" rx="2" fill="#E8F4FF"/>
        <rect x="-25" y="-5" width="16" height="10" fill="#438CCB"/>
        <rect x="9" y="-5" width="16" height="10" fill="#438CCB"/>
        <path d="M0 -6 V-13 M-4 -13 H4" stroke="#E8F4FF" stroke-width="1.5"/>
      </g>
    </g>

    <!-- Data signals -->
    <g fill="#FFB66D">
      <circle cx="760" cy="115" r="3">
        <animate attributeName="opacity" values="0;1;0" dur="2.5s" repeatCount="indefinite"/>
      </circle>
      <circle cx="1090" cy="275" r="3">
        <animate attributeName="opacity" values="0;1;0" dur="3s" repeatCount="indefinite"/>
      </circle>
      <circle cx="800" cy="280" r="2">
        <animate attributeName="opacity" values="0;1;0" dur="2s" repeatCount="indefinite"/>
      </circle>
    </g>

    <!-- Horizontal telemetry -->
    <path d="M660 330 H1160" stroke="url(#line)" stroke-width="1"/>
    <path d="M660 330 H1160" stroke="#FFAA63" stroke-width="2" stroke-dasharray="30 470">
      <animate attributeName="stroke-dashoffset" from="500" to="0" dur="5s" repeatCount="indefinite"/>
    </path>

    <!-- Typography -->
    <text x="72" y="95" fill="#FFAA63" font-family="monospace" font-size="13" letter-spacing="4">ADITYA-L1 / SPACE WEATHER INTELLIGENCE</text>

    <text x="68" y="190" fill="#F4F7FC" font-family="Arial, sans-serif" font-size="76" font-weight="700" letter-spacing="5">ARUNA</text>

    <text x="74" y="225" fill="#AFC2DB" font-family="Arial, sans-serif" font-size="17" letter-spacing="1.5">
      REAL-TIME UNIFIED NOWCASTING &amp; ALERT SYSTEM
    </text>

    <rect x="74" y="257" width="34" height="2" rx="1" fill="#FF9B52"/>
    <text x="74" y="287" fill="#D4DFEF" font-family="Arial, sans-serif" font-size="15">
      FORESEE. PREPARE. PROTECT.
    </text>

    <text x="74" y="345" fill="#7188A8" font-family="monospace" font-size="11" letter-spacing="2">
      OPEN-SOURCE SCIENTIFIC COMPUTING
    </text>

    <!-- Status -->
    <circle cx="1100" cy="42" r="4" fill="#63DDA2">
      <animate attributeName="opacity" values="1;.25;1" dur="2s" repeatCount="indefinite"/>
    </circle>
    <text x="1114" y="46" fill="#A8C4D9" font-family="monospace" font-size="10">IN DEVELOPMENT</text>
  </g>
</svg>
